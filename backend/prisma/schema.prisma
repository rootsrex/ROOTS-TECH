generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: VIEWER | DANCER | ADMIN
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @default("")
  googleId     String?  @unique
  role         String   @default("VIEWER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dancer           Dancer?
  wallet           Wallet?
  sentStickers     StickerTransaction[] @relation("SenderTransactions")
  sentGifts        GiftTransaction[]    @relation("SenderGiftTransactions")
  coinTopUps       CoinTopUp[]
}

// contentLevel: BASIC | PREMIUM | EXCLUSIVE
model Dancer {
  id           String  @id @default(uuid())
  userId       String  @unique
  displayName  String
  bio          String  @default("")
  avatarUrl    String  @default("")
  isLive       Boolean @default(false)
  isVerified   Boolean @default(false)
  contentLevel String  @default("BASIC")

  whatsapp     String  @default("")
  takenos      String  @default("")
  cedula       String  @default("")
  bankAccount  String?
  bankName     String?

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerPacks     StickerPack[]
  sessions         LiveSession[]
  receivedStickers StickerTransaction[] @relation("ReceiverTransactions")
  receivedGifts    GiftTransaction[]    @relation("ReceivedGifts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id             String @id @default(uuid())
  userId         String @unique
  balanceUSD     Float  @default(0)
  coinBalance    Float  @default(0)
  totalEarned    Float  @default(0)
  totalWithdrawn Float  @default(0)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  updatedAt DateTime @updatedAt
}

// Catálogo de regalos de la plataforma
// category: BASIC | PREMIUM | EXCLUSIVE
// animation: pop | float | rain | explosion
model Gift {
  id          String  @id @default(uuid())
  name        String
  emoji       String
  description String  @default("")
  coinCost    Int
  category    String  @default("BASIC")
  animation   String  @default("pop")
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  transactions GiftTransaction[]

  createdAt DateTime @default(now())
}

// Paquetes de monedas para comprar
model CoinPackage {
  id        String  @id @default(uuid())
  name      String
  coins     Int
  priceUSD  Float
  bonus     Int     @default(0)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  topUps CoinTopUp[]

  createdAt DateTime @default(now())
}

// Solicitud de recarga de monedas
// method: TAKENOS | CARD | TRANSFER | USDT
// status: PENDING | COMPLETED | REJECTED
model CoinTopUp {
  id          String    @id @default(uuid())
  userId      String
  packageId   String?
  coins       Float
  bonusCoins  Float     @default(0)
  priceUSD    Float
  method      String    @default("TAKENOS")
  reference   String    @default("")
  status      String    @default("PENDING")
  processedAt DateTime?
  notes       String    @default("")

  user    User         @relation(fields: [userId], references: [id])
  package CoinPackage? @relation(fields: [packageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Transacción de regalo con monedas
model GiftTransaction {
  id          String  @id @default(uuid())
  senderId    String
  dancerId    String
  sessionId   String?
  giftId      String
  quantity    Int     @default(1)
  coinsCost   Int
  coinsEarned Int
  message     String  @default("")

  sender  User         @relation("SenderGiftTransactions", fields: [senderId], references: [id])
  dancer  Dancer       @relation("ReceivedGifts", fields: [dancerId], references: [id])
  session LiveSession? @relation(fields: [sessionId], references: [id])
  gift    Gift         @relation(fields: [giftId], references: [id])

  createdAt DateTime @default(now())
}

// contentLevel: BASIC | PREMIUM | EXCLUSIVE
model StickerPack {
  id           String  @id @default(uuid())
  dancerId     String
  name         String
  emoji        String
  description  String  @default("")
  priceUSD     Float
  contentLevel String  @default("BASIC")
  isActive     Boolean @default(true)

  dancer       Dancer               @relation(fields: [dancerId], references: [id], onDelete: Cascade)
  transactions StickerTransaction[]

  createdAt DateTime @default(now())
}

model LiveSession {
  id          String    @id @default(uuid())
  dancerId    String
  title       String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  viewerCount Int       @default(0)
  totalEarned Float     @default(0)

  dancer           Dancer               @relation(fields: [dancerId], references: [id], onDelete: Cascade)
  transactions     StickerTransaction[]
  giftTransactions GiftTransaction[]

  createdAt DateTime @default(now())
}

// status: PENDING | COMPLETED | FAILED | REFUNDED
model StickerTransaction {
  id            String  @id @default(uuid())
  senderId      String
  dancerId      String
  sessionId     String?
  stickerPackId String
  quantity      Int     @default(1)
  totalUSD      Float
  platformFee   Float
  dancerEarning Float
  message       String  @default("")
  status        String  @default("COMPLETED")

  sender      User         @relation("SenderTransactions", fields: [senderId], references: [id])
  dancer      Dancer       @relation("ReceiverTransactions", fields: [dancerId], references: [id])
  session     LiveSession? @relation(fields: [sessionId], references: [id])
  stickerPack StickerPack  @relation(fields: [stickerPackId], references: [id])

  createdAt DateTime @default(now())
}

// method: TAKENOS | BANK_TRANSFER
// status: PENDING | PROCESSING | COMPLETED | REJECTED
model Withdrawal {
  id          String    @id @default(uuid())
  walletId    String
  amountUSD   Float
  method      String
  destination String
  status      String    @default("PENDING")
  reference   String?
  processedAt DateTime?
  notes       String    @default("")

  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformConfig {
  id                 String @id @default("singleton")
  commissionRate     Float  @default(0.20)
  coinToUSD          Float  @default(0.01)
  takenosBonusCoins  Float  @default(0.5)
  minWithdrawal      Float  @default(10.0)
  maxWithdrawal      Float  @default(500.0)
  payoutDay          String @default("WEDNESDAY")
  takenosAdminId     String @default("")
  bankName           String @default("")
  bankAccount        String @default("")
  bankAccountHolder  String @default("")
  usdtWallet         String @default("")
  usdtNetwork        String @default("TRC20")
}
